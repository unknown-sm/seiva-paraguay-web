# Agent API
PORT=3001

# API keys (separadas por coma) que n8n usa en el header Authorization: Bearer <key>
AGENT_API_KEYS=dev-key-change-me

# Postgres del ecommerce. Si se deja sin definir, la API arranca en MOCK_MODE=1
# (stores en memoria + adapter mock: ideal para desarrollo sin BD).
# DATABASE_URL=postgres://agent:agent@localhost:5432/ecommerce_agent

# Forzar modo mock aunque haya DATABASE_URL
# MOCK_MODE=1

# Límite de ejecuciones de tools por minuto y por sesión
RATE_LIMIT_PER_MINUTE=60

LOG_LEVEL=info
